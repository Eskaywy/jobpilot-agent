# =====================================================================
# JobPilot Agent - environment template
# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env        (Windows PowerShell: Copy-Item)
# NEVER commit the real .env file (it is git-ignored).
# =====================================================================

# --- Candidate identity (used in emails and PDF documents) ----------
SENDER_NAME=Your Name
SENDER_PHONE=+1 (555) 010-0100
SENDER_LOCATION=City, Country

# --- SMTP credentials -------------------------------------------------
# Gmail: enable 2FA, then create an App Password:
#   https://myaccount.google.com/apppasswords
# Use that 16-character App Password below (NOT your normal password).
# Outlook/Office365: SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_USE_SSL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# --- Behaviour --------------------------------------------------------
# true  = emails are rendered to ./outbox/ but never sent (SAFE - default)
# false = live sending via SMTP (only after you verified dry-run output!)
DRY_RUN=true

# Blended ATS match score (0..1) above which an existing resume is reused
# instead of generating a new tailored one. Spec threshold: 0.90
MATCH_THRESHOLD=0.90

# Minimum blended ATS score required to actually APPLY to a listing
# (0.40 = apply only when the JD matches the profile at 40%+; 0 disables).
MIN_APPLY_SCORE=0.40
# Only apply to (and watchlist) remote / work-from-home postings. Listings
# that look hybrid, on-site or explicitly non-remote are dropped at
# discovery time and never reach the dispatcher.
REMOTE_ONLY=true

# Safety cap: maximum applications dispatched per hourly cycle.
MAX_APPLICATIONS_PER_CYCLE=5

# Scheduler interval for the hourly loop (minutes). 60 = hourly (spec).
CYCLE_INTERVAL_MINUTES=60

# Network timeout for job-board API requests (seconds).
REQUEST_TIMEOUT=20

# Set to "true" ONLY to test the pipeline offline with fixtures/jobs.json.
ENABLE_FIXTURES=false

# --- Adzuna API (free job source) -------------------------------------
# 1. Register a free app at https://developer.adzuna.com
# 2. Copy your app_id and app_key from the dashboard into the two lines
#    below (both are required - the provider stays disabled without them).
# 3. ADZUNA_COUNTRY picks the Adzuna country endpoint. NOTE: Nigeria is
#    not covered by Adzuna; supported codes include us, gb, za, in, ca,
#    de, fr, nl, it, es, au, br, mx, nz, pl, ru, sg, ch.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# --- SerpApi (Google Jobs, free plan = 100 searches/month) -------------
# Get your key at https://serpapi.com/manage-api-key. The agent spends one
# search credit per search term per cycle. NOTE: engine=google_jobs is used
# because the plain engine=google returns web results, not job postings.
SERPAPI_API_KEY=
SERPAPI_ENGINE=google_jobs
# Quota protection: minimum hours between SerpApi runs (default 12).
SERPAPI_MIN_INTERVAL_HOURS=12

# --- JSearch (RapidAPI job search + job details) -------------------------
# 1. Get a free key at https://rapidapi.com/jsearchapi-jsearchapi/api/jsearch
# 2. Set JSEARCH_API_KEY below; JSEARCH_COUNTRY selects the market
#    (supported codes include us, gb, uk, ca, au, de, fr, in).
# job-details (python main.py --job-id <id>) works on every subscription.
# Discovery via /search costs one request per search term per cycle but is
# only available on subscriptions that include that endpoint, so it is
# opt-in via JSEARCH_DISCOVERY_ENABLED.
JSEARCH_API_KEY=
JSEARCH_COUNTRY=us
JSEARCH_DISCOVERY_ENABLED=false
